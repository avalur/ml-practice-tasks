# Copy to web/.env.local and fill in. Never commit real secrets.

# Auth.js session encryption key. Generate one with:  npx auth secret
AUTH_SECRET=

# GitHub OAuth App — https://github.com/settings/developers (New OAuth App)
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
#   Create "OAuth client ID" → Web application
#   Authorized redirect URI:    http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Postgres (e.g. Neon — https://neon.tech, free tier). DATABASE_URL is the pooled
# connection used at runtime; DIRECT_URL is a direct (non-pooled) connection used
# for migrations / `prisma db push`. With a local Postgres both can be the same.
DATABASE_URL=
DIRECT_URL=

# Canonical origin of this deployment, e.g. https://www.mlpractice.com. Used for
# links that leave the server (the password-reset email). Set it in production:
# without it the link is built from the request's Host header, which the sender
# controls. Locally it can stay empty.
SITE_URL=

# Resend — sends the password-reset link (https://resend.com, free tier).
# Verify the sending domain there, then put an address on it in MAIL_FROM.
# Optional: without a key the letter is printed to the server log instead, which
# is how the reset flow is walked through locally and in CI.
RESEND_API_KEY=
MAIL_FROM="ML Practice <noreply@mlpractice.com>"

# Vercel Blob — where "Finish lesson" publishes the annotated lecture PDF.
# Vercel dashboard → Storage → Create → Blob → connect it to this project, then
# `vercel env pull web/.env.local` (or copy the token from the store's page).
# A **private** store is what the code expects: lecture notes are served through
# /api/classes/<slug>/lessons/<lesson>/notes, which checks class membership and
# signs a short-lived link. Optional: without the token the PDF still downloads
# to the teacher's machine, it just is not published on the lesson page.
BLOB_READ_WRITE_TOKEN=
