// Phase 2 schema. Auth.js models + app models (problems, submissions, progress).
// clientStatus/verifiedStatus are kept distinct from day one: solving is verified
// client-side (Pyodide), so progress is "client-solved" until a future server-side
// re-verification pass flips verifiedSolved.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- Auth.js (NextAuth) models ---

model User {
  id               String                 @id @default(cuid())
  name             String?
  email            String?                @unique
  emailVerified    DateTime?
  image            String?
  accounts         Account[]
  sessions         Session[]
  submissions      Submission[]
  progress         UserProblemProgress[]
  favorites        Favorite[]
  notebookProgress UserNotebookProgress[]
  enrollments      ClassEnrollment[]
  createdAt        DateTime               @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

model Problem {
  id          String   @id // "topic/slug"
  topic       String
  slug        String
  title       String
  difficulty  String
  contentHash String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions Submission[]
  progress    UserProblemProgress[]
  favorites   Favorite[]

  @@unique([topic, slug])
}

model Submission {
  id             String   @id @default(cuid())
  userId         String
  problemId      String
  code           String   @db.Text
  clientStatus   String // "passed" | "failed" | "error" | "timeout"
  verifiedStatus String? // server re-verification (future)
  passed         Int
  total          Int
  durationMs     Int?
  runnerVersion  String?
  pyodideVersion String?
  errorKind      String?
  createdAt      DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, problemId])
  @@index([createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

model UserNotebookProgress {
  id           String    @id @default(cuid())
  userId       String
  notebookId   String // "gradient_descent/intro"
  code         String?   @db.Text // latest captured student code (for restore)
  attemptCount Int       @default(0)
  solvedAt     DateTime? // null until all tests pass
  lastRunAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notebookId])
}

// --- Classes ---
// Structure (lessons, decks, practice, homework) lives in files under classes/
// and is read at request time; only dynamic state is stored here. Homework
// completion is derived from UserProblemProgress/UserNotebookProgress, so it
// needs no table of its own.

model Class {
  id            String   @id @default(cuid())
  slug          String   @unique // matches classes/<slug>/
  title         String
  inviteCode    String   @unique // generated on first sync, never rotated
  teacherEmails String[] // seeded from class.json; authorizes before first sign-in
  createdAt     DateTime @default(now())

  enrollments ClassEnrollment[]
  sessions    LessonSession[]
}

model ClassEnrollment {
  id       String   @id @default(cuid())
  classId  String
  userId   String
  joinedAt DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([userId])
}

// One row per lesson actually delivered. Created when the teacher hits Present.
model LessonSession {
  id         String    @id @default(cuid())
  classId    String
  lessonSlug String
  deckHash   String // detects ink drawn against a since-edited deck
  startedAt  DateTime  @default(now())
  // Set when the teacher presses "Finish lesson". The PDF itself is downloaded to
  // the teacher's machine and shared out of band, so only its size is recorded.
  endedAt    DateTime?
  pdfBytes   Int?
  // Blank boards inserted during the lesson: [{id, afterId}] in insertion order.
  // They are real reveal sections injected into the deck at runtime, so the deck
  // file stays untouched and this is the only record of where they went.
  boards     Json?

  class       Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  annotations LessonAnnotation[]

  @@index([classId, lessonSlug])
}

model LessonAnnotation {
  id        String   @id @default(cuid())
  sessionId String
  pageKey   String // "3.1" = slide h.v, "3.1#b2" = 2nd blank board after it
  strokes   Json // [{c,w,hl,p:[[x,y,pressure],…]}] normalized to the slide box
  updatedAt DateTime @updatedAt

  session LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, pageKey])
}

model UserProblemProgress {
  id               String    @id @default(cuid())
  userId           String
  problemId        String
  clientSolved     Boolean   @default(false)
  verifiedSolved   Boolean   @default(false)
  attemptCount     Int       @default(0)
  bestPassed       Int       @default(0)
  bestTotal        Int       @default(0)
  solvedAt         DateTime?
  lastSubmittedAt  DateTime?
  bestSubmissionId String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}
