// Phase 2 schema. Auth.js models + app models (problems, submissions, progress).
// clientStatus/verifiedStatus are kept distinct from day one: solving is verified
// client-side (Pyodide), so progress is "client-solved" until a future server-side
// re-verification pass flips verifiedSolved.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- Auth.js (NextAuth) models ---

model User {
  id            String    @id @default(cuid())
  // `name` stays the display string every page already reads (header, rosters,
  // the monitor feed) and is written from firstName/lastName whenever those are
  // edited. OAuth accounts arrive with only `name`, so both shapes have to work
  // — see src/lib/person.ts.
  name          String?
  firstName     String?
  lastName      String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Set only for accounts that registered with a password (OAuth users have
  // none until they set one through the reset-by-email flow). Format is
  // scrypt$N$r$p$salt$hash — see src/lib/password.ts.
  passwordHash  String?
  // Failed sign-in throttling. Cleared on every successful sign-in.
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?

  accounts         Account[]
  sessions         Session[]
  passwordResets   PasswordResetToken[]
  submissions      Submission[]
  progress         UserProblemProgress[]
  favorites        Favorite[]
  notebookProgress UserNotebookProgress[]
  enrollments      ClassEnrollment[]
  createdAt        DateTime               @default(now())
}

// A password-reset link, one row per request. Only the SHA-256 of the token that
// went out by email is stored: the database never holds anything that can be
// mailed back as a link. Single use, short lived.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

model Problem {
  id          String   @id // "topic/slug"
  topic       String
  slug        String
  title       String
  difficulty  String
  contentHash String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions Submission[]
  progress    UserProblemProgress[]
  favorites   Favorite[]

  @@unique([topic, slug])
}

model Submission {
  id             String   @id @default(cuid())
  userId         String
  problemId      String
  code           String   @db.Text
  clientStatus   String // "passed" | "failed" | "error" | "timeout"
  verifiedStatus String? // server re-verification (future)
  passed         Int
  total          Int
  durationMs     Int?
  runnerVersion  String?
  pyodideVersion String?
  errorKind      String?
  createdAt      DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, problemId])
  @@index([createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

model UserNotebookProgress {
  id           String    @id @default(cuid())
  userId       String
  notebookId   String // "gradient_descent/intro"
  code         String?   @db.Text // latest captured student code (for restore)
  attemptCount Int       @default(0)
  solvedAt     DateTime? // null until all tests pass
  lastRunAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notebookId])
}

// --- Classes ---
// Structure (lessons, decks, practice, homework) lives in files under classes/
// and is read at request time; only dynamic state is stored here. Homework
// completion is derived from UserProblemProgress/UserNotebookProgress, so it
// needs no table of its own.

model Class {
  id            String   @id @default(cuid())
  slug          String   @unique // matches classes/<slug>/
  title         String
  teacherEmails String[] // seeded from class.json; authorizes before first sign-in
  createdAt     DateTime @default(now())
  // null = draft: visible to its teachers only, nowhere in the public lists. The
  // DB is the only truth here, because Publish has to work from the site without
  // a redeploy; class.json's `"draft": true` merely picks the value the row is
  // created with. The `@default(now())` is what backfills the classes that
  // existed before this column, so nothing goes dark on `prisma db push`.
  publishedAt   DateTime? @default(now())

  invites     ClassInvite[]
  enrollments ClassEnrollment[]
  sessions    LessonSession[]
}

// One invite code, handed out to one group of students. A class can have several
// — the code a student typed is what tells cohorts apart in the homework
// overview, so the teacher writes both the code and the group's name.
model ClassInvite {
  id        String   @id @default(cuid())
  classId   String
  code      String // as the teacher wrote it, e.g. "TLF-OSEN-A"
  // Same code with the separators and case thrown away. Codes are read out loud
  // and typed back from memory, so lookup and uniqueness both use this form.
  codeKey   String   @unique
  label     String // the group's name, e.g. "Autumn stream A"
  createdAt DateTime @default(now())

  class       Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments ClassEnrollment[]

  @@index([classId])
}

model ClassEnrollment {
  id       String   @id @default(cuid())
  classId  String
  userId   String
  // Which code the student came in with — null for the teachers seeded by
  // sync-classes.cjs, who are in the roster without ever typing one.
  inviteId String?
  joinedAt DateTime @default(now())

  class  Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invite ClassInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  @@unique([classId, userId])
  @@index([userId])
  @@index([inviteId])
}

// One row per lesson actually delivered. Created when the teacher hits Present.
model LessonSession {
  id         String    @id @default(cuid())
  classId    String
  lessonSlug String
  deckHash   String // detects ink drawn against a since-edited deck
  startedAt  DateTime  @default(now())
  // Set when the teacher presses "Finish lesson": the PDF goes straight to their
  // downloads, and a copy is uploaded to Vercel Blob in the background. pdfUrl is
  // null until that upload lands (or stays null if no Blob store is configured —
  // the local file is the primary copy, publishing is the bonus).
  endedAt    DateTime?
  pdfBytes   Int?
  pdfUrl     String?
  // Blank boards inserted during the lesson: [{id, afterId}] in insertion order.
  // They are real reveal sections injected into the deck at runtime, so the deck
  // file stays untouched and this is the only record of where they went.
  boards     Json?

  class       Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  annotations LessonAnnotation[]

  @@index([classId, lessonSlug])
}

model LessonAnnotation {
  id        String   @id @default(cuid())
  sessionId String
  pageKey   String // "3.1" = slide h.v, "3.1#b2" = 2nd blank board after it
  strokes   Json // [{c,w,hl,p:[[x,y,pressure],…]}] normalized to the slide box
  updatedAt DateTime @updatedAt

  session LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, pageKey])
}

model UserProblemProgress {
  id               String    @id @default(cuid())
  userId           String
  problemId        String
  clientSolved     Boolean   @default(false)
  verifiedSolved   Boolean   @default(false)
  attemptCount     Int       @default(0)
  bestPassed       Int       @default(0)
  bestTotal        Int       @default(0)
  solvedAt         DateTime?
  lastSubmittedAt  DateTime?
  bestSubmissionId String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}
